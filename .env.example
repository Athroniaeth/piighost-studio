# OpenPanel analytics (auto-hébergé).
# Sans NEXT_PUBLIC_OPENPANEL_CLIENT_ID, aucun suivi n'est activé (dev/local par défaut).
# clientId public (inliné dans le bundle client) — récupéré dans le dashboard OpenPanel.
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=
# URL de l'API OpenPanel auto-hébergée (sans slash final) — destination des événements.
# Défaut si absent : https://opapi.athroniaeth.cloud
NEXT_PUBLIC_OPENPANEL_API_URL=https://opapi.athroniaeth.cloud
# URL du loader op1.js. L'API auto-hébergée ne sert PAS op1.js (404) : on le charge
# depuis le CDN OpenPanel par défaut. À ne changer que si vous servez votre propre op1.js.
# Défaut si absent : https://openpanel.dev/op1.js
NEXT_PUBLIC_OPENPANEL_SCRIPT_URL=https://openpanel.dev/op1.js

# --- Option first-party (contourne Brave / uBlock qui bloquent openpanel.dev) ---
# Servez op1.js et l'ingestion sous VOTRE domaine via nginx (voir docs/openpanel-nginx.conf),
# puis remplacez les deux variables ci-dessus par :
#   NEXT_PUBLIC_OPENPANEL_SCRIPT_URL=https://piighost.athroniaeth.cloud/op1.js
#   NEXT_PUBLIC_OPENPANEL_API_URL=https://piighost.athroniaeth.cloud/api/op
